{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autofeaturetour.local/schemas/v1/platform.schema.json",
  "title": "AutoFeatureTour platform (platforms/<name>/platform.json)",
  "description": "How the app behaves wherever it runs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors: a relative path to schemas/<type>.schema.json."
    },
    "comment": {
      "type": "string",
      "description": "A note for people."
    },
    "ready": {
      "type": "object",
      "description": "When a page counts as ready after an action, for apps that never go network-idle.",
      "properties": {
        "busy": {
          "type": "string",
          "description": "CSS of busy indicators (spinners, skeletons); wait until none is visible."
        },
        "stableMs": {
          "description": "Then the page must not change for this long (default 1500).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "timeout": {
          "description": "Max wait for busy indicators to go (default 60000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "stableTimeout": {
          "description": "Max wait for a stable page (default 15000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "strict": {
          "type": "boolean",
          "description": "A page that never settles is an APP failure (default: a warning)."
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "description": "The app's own error UI: a step that leaves it visible fails as APP.",
      "properties": {
        "selector": {
          "type": "string",
          "description": "CSS of the error element (dialog, toast)."
        },
        "text": {
          "type": "string",
          "description": "Only when its text matches this regex."
        }
      },
      "additionalProperties": false,
      "required": [
        "selector"
      ]
    },
    "appErrors": {
      "type": "object",
      "description": "What browser-side errors during a step do: \"fail\" (APP failure) or \"warn\" (listed in the report).",
      "properties": {
        "network": {
          "enum": [
            "fail",
            "warn"
          ],
          "description": "HTTP 5xx responses (default warn)."
        },
        "network4xx": {
          "enum": [
            "fail",
            "warn"
          ],
          "description": "Also fail on 4xx."
        },
        "console": {
          "enum": [
            "fail",
            "warn"
          ],
          "description": "console.error messages (default warn)."
        },
        "pageErrors": {
          "enum": [
            "fail",
            "warn"
          ],
          "description": "Uncaught exceptions (default warn)."
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regexes of known noisy requests/messages: kept in network.json/console.json, marked ignored, never a cause."
        }
      },
      "additionalProperties": false
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regexes of known noisy requests/messages: kept in network.json/console.json, marked ignored, never a cause."
    },
    "mask": {
      "type": "object",
      "description": "Blurred in the page before anything is recorded (video, screenshots, trace).",
      "properties": {
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CSS of elements to blur."
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regexes of text to blur."
        }
      },
      "additionalProperties": false
    },
    "pronounce": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Narration substitutions: written form → how to say it (\"RMS\": \"R M S\")."
    },
    "viewport": {
      "type": "object",
      "description": "Browser size in CSS pixels (default 1440×810).",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "voice": {
      "type": "string",
      "description": "SAPI voice."
    },
    "ignoreHTTPSErrors": {
      "type": "boolean",
      "description": "Accept self-signed certificates."
    },
    "startPath": {
      "type": "string",
      "description": "Where sessions and discovery start (default /)."
    },
    "discover": {
      "type": "object",
      "description": "Discovery hints.",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra paths to crawl."
        }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
      "description": "Milliseconds per kind of step.",
      "properties": {
        "action": {
          "description": "Actions: finding and acting on an element (default 10000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "verify": {
          "description": "Checks (default 15000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "waitFor": {
          "description": "waitFor steps (default 30000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "navigation": {
          "description": "Page loads (default 30000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "optional": {
          "description": "Optional steps (default 3000).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "retries": {
      "description": "Retries for actions that time out (default 1).",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "common.schema.json#/$defs/placeholder"
        }
      ]
    },
    "trace": {
      "type": "boolean",
      "description": "false: no trace.zip."
    },
    "video": {
      "type": "object",
      "description": "Post-processing of the recording.",
      "properties": {
        "trimWaits": {
          "enum": [
            "cut",
            "speed",
            "off"
          ],
          "description": "Long waits (page loads, busy indicators, waitFor, waitForResponse, dismissed known issues): cut them (default), speed them up, or keep them. The narration is never cut. --no-trim keeps them for one run."
        },
        "trimWaitsOver": {
          "description": "Only waits longer than this many seconds (default 1.5).",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "speed": {
          "description": "With \"speed\": how much faster (default 4).",
          "anyOf": [
            {
              "type": "number",
              "minimum": 1
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        },
        "leadIn": {
          "description": "Seconds of each trimmed wait that stay, so the cut is not jarring (default 0.3).",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "$ref": "common.schema.json#/$defs/placeholder"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "workarounds": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A known app or environment issue: what it looks like, what to do about it, how to report it. Tours never mention it; when the issue is absent nothing happens.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique name; reports say \"known issue <name>\". An environment rule with the same name refines the platform's."
          },
          "comment": {
            "type": "string",
            "description": "A note for people (why it happens, the ticket)."
          },
          "when": {
            "description": "What the issue looks like: a locator (popup, panel, banner, toast), a failing request, or a console message / uncaught exception.",
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/locator"
              },
              {
                "type": "object",
                "description": "A failing request.",
                "properties": {
                  "request": {
                    "type": "string",
                    "description": "URL substring, or /regex/."
                  },
                  "status": {
                    "description": "HTTP status: 503, \"5xx\", \"4xx\", or a list (default any failure).",
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\dxx$"
                      },
                      {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "string",
                              "pattern": "^\\dxx$"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "description": "Only this HTTP method."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "request"
                ]
              },
              {
                "type": "object",
                "description": "A console error or uncaught exception.",
                "properties": {
                  "console": {
                    "type": "string",
                    "description": "Message substring, or /regex/."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "console"
                ]
              }
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only on pages whose URL contains (or matches /regex/) one of these."
          },
          "do": {
            "description": "Steps that dismiss it (scoped to the matched element unless \"scoped\": false; its UI must be gone afterwards unless \"noWaitAfter\"), \"tolerate\" (leave it; it does not fail the step through errors / appErrors), or \"hide\" (CSS display:none: fakes the app's state, reported as such). Default tolerate.",
            "anyOf": [
              {
                "enum": [
                  "tolerate",
                  "hide"
                ]
              },
              {
                "$ref": "common.schema.json#/$defs/steps",
                "minItems": 1
              }
            ]
          },
          "as": {
            "enum": [
              "warn",
              "fail",
              "silent"
            ],
            "description": "warn (default: in the report, the run passes), fail (APP, exit 5: this known issue must not happen here), silent (report.json only)."
          },
          "times": {
            "description": "At most this many firings per run; after that it is a normal error again.",
            "anyOf": [
              {
                "type": "number",
                "minimum": 1
              },
              {
                "$ref": "common.schema.json#/$defs/placeholder"
              }
            ]
          },
          "noWaitAfter": {
            "type": "boolean",
            "description": "After its steps, do not wait for the UI to go."
          },
          "scoped": {
            "type": "boolean",
            "description": "false: its steps search the whole page, not just inside the matched element."
          },
          "off": {
            "type": "boolean",
            "description": "In an environment: turn the platform's rule of this name off there."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "description": "Known issues (see the workaround definition). Platform rules apply everywhere; environments refine them by name."
    }
  }
}
