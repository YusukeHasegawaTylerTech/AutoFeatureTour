{
  "$schema": "../../schemas/environments.schema.json",
  "default": "local",
  "local": {
    "comment": "Your dev machine. Attaches to running services; starts a missing one with the dev scripts (never -Force) and leaves it running.",
    "baseUrl": "http://localhost:4200/",
    "launch": [
      {
        "name": "rms-api",
        "healthUrl": "https://localhost:6600/",
        "anyStatus": true,
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1 -Service api",
        "timeoutSeconds": 600,
        "stop": false
      },
      {
        "name": "rms-web",
        "healthUrl": "http://localhost:4200/",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1 -Service web",
        "timeoutSeconds": 420,
        "stop": false
      }
    ]
  }
}
