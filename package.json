{
  "name": "autofeaturetour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Narrated feature-tour videos of web apps: story → script → validated, paced Playwright recording → video.",
  "bin": {
    "aft": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tour": "node src/cli.mjs",
    "test": "node --test",
    "schemas": "node src/schema-defs.mjs --write",
    "ui": "node ui/server.mjs",
    "start": "node start.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.56.0"
  },
  "optionalDependencies": {
    "pdfjs-dist": "^5.4.0"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "schemas",
    "ui"
  ]
}
