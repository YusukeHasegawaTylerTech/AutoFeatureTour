{
  "name": "rms",
  "target": "rms",
  "baseUrl": "http://localhost:4200/",
  "startPath": "#/home",
  "environments": {
    "local": { "baseUrl": "http://localhost:4200/" }
  },
  "launch": [
    {
      "name": "rms-api",
      "healthUrl": "https://localhost:6600/",
      "anyStatus": true,
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1 -Service api",
      "timeoutSeconds": 600,
      "stop": false
    },
    {
      "name": "rms-web",
      "healthUrl": "http://localhost:4200/",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1 -Service web",
      "timeoutSeconds": 420,
      "stop": false
    }
  ],
  "ignoreHTTPSErrors": true,
  "viewport": { "width": 1600, "height": 900 },
  "ready": {
    "busy": "forge-skeleton, mat-spinner, mat-progress-spinner, forge-circular-progress, forge-linear-progress, .loading-backdrop, .loading-spinner, .busy-wrapper",
    "stableMs": 1500,
    "stableTimeout": 15000,
    "timeout": 60000
  },
  "timeouts": { "action": 20000, "verify": 30000, "waitFor": 60000, "navigation": 90000, "optional": 5000 },
  "login": {
    "role": "dev",
    "signedIn": "forge-app-bar-profile-button",
    "steps": [
      { "goto": "#/home" },
      { "fill": "#Username", "text": "{env:AFT_RMS_USERNAME}", "timeout": 60000 },
      { "fill": "#passwordField", "text": "{env:AFT_RMS_PASSWORD}", "secret": true },
      { "click": "#cjisAcknowledgment", "optional": true },
      { "click": { "role": "button", "name": "Sign In" } },
      { "waitFor": "css=forge-app-bar-profile-button", "timeout": 90000 }
    ]
  },
  "discover": { "paths": ["#/report/search", "#/report/builder", "#/report/manage"] },
  "mask": { "patterns": ["\\b\\d{3}-\\d{2}-\\d{4}\\b"] },
  "pronounce": { "RMS": "R M S", "EPD": "E P D", "IBR": "I B R" },
  "scenes": [
    {
      "title": "RMS home",
      "narration": "This is the R M S home page, signed in as the local development user. Every tour of this application starts from here.",
      "steps": [ { "point": "css=forge-app-bar-profile-button", "optional": true } ]
    }
  ]
}
