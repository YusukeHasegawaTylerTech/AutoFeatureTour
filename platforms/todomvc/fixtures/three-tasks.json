{
  "$schema": "../../../schemas/fixture.schema.json",
  "description": "Three tasks in the list, the second one completed. Put in place off camera, through the UI.",
  "data": { "first": "Renew the parking permit", "second": "Book the conference room", "third": "Send the weekly report" },
  "steps": [
    { "goto": "#/" },
    { "use": "add-todo", "with": { "text": "{data.first}" } },
    { "use": "add-todo", "with": { "text": "{data.second}" } },
    { "use": "add-todo", "with": { "text": "{data.third}" } },
    { "click": { "role": "checkbox", "name": "Toggle Todo", "nth": 1 } }
  ]
}
